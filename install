    echo -e "${BIBlue}╰══════════════════════════════════════════╯${NC}"
    res12

 echo -e "${BIBlue}╭══════════════════════════════════════════╮${NC}"
    echo -e "${BIBlue}│ ${BGCOLOR} PANTAU PEMAKAIANA KUOTA           ${NC}${BIBlue} │${NC}"
    echo -e "${BIBlue}╰══════════════════════════════════════════╯${NC}"
    res12
}
Download # Memanggil fungsi SKT4100

# --- Konfigurasi Post-Instalasi ---
# Pastikan file /home/re_otm ada dan berikan nilai default jika tidak
if [ ! -f "/home/re_otm" ]; then
    echo "0" > /home/re_otm
fi

cat > /root/.profile << END
if [ "$BASH" ]; then
if [ -f ~/.bashrc ]; then
. ~/.bashrc
fi
fi
mesg n || true
clear
menu
END
chmod 644 /root/.profile

# Bersihkan file log instalasi sebelumnya
if [ -f "/root/log-install.txt" ]; then
    rm /root/log-install.txt > /dev/null 2>&1
fi
if [ -f "/etc/afak.conf" ]; then
    rm /etc/afak.conf > /dev/null 2>&1
