# --- Fungsi Instalasi Modul ---
res3() {
    echo -e "${GREEN}    Memulai instalasi SSH WS / OpenVPN...${NC}"
    wget https://raw.githubusercontent.com/freetunnel/bal/main/system/ssh-vpn.sh -O ssh-vpn.sh
    chmod +x ssh-vpn.sh
    ./ssh-vpn.sh
    sudo systemctl enable --now chrony.service
    sudo systemctl restart chrony.service
    clear
}

res4() {
    echo -e "${GREEN}    Memulai instalasi XRAY...${NC}"
    wget https://raw.githubusercontent.com/freetunnel/bal/main/system/ins-xray.sh -O ins-xray.sh
    chmod +x ins-xray.sh
    ./ins-xray.sh
    clear
}

res5() {
    echo -e "${GREEN}    Memulai instalasi WEBSOCKET SSH...${NC}"
    wget https://raw.githubusercontent.com/freetunnel/bal/main/websocket/insshws.sh -O insshws.sh
    chmod +x insshws.sh
    ./insshws.sh
    clear
}

res6() {
    echo -e "${GREEN}    Memulai instalasi BACKUP MENU...${NC}"
    wget https://raw.githubusercontent.com/freetunnel/bal/main/system/set-br.sh -O set-br.sh
    chmod +x set-br.sh
    ./set-br.sh
    clear
}

res7() {
    echo -e "${GREEN}    Memulai instalasi OHP...${NC}"
    wget https://raw.githubusercontent.com/freetunnel/bal/main/websocket/ohp.sh -O ohp.sh
    chmod +x ohp.sh
    ./ohp.sh
    clear
}

res8() {
    echo -e "${GREEN}    Memulai pengunduhan EXTRA MENU...${NC}"
    wget https://raw.githubusercontent.com/freetunnel/bal/main/menu/update.sh -O update.sh
    chmod +x update.sh
    ./update.sh
    clear
}

res9() {
    echo -e "${GREEN}    Memulai pengunduhan SLOWDNS...${NC}"
    wget https://raw.githubusercontent.com/freetunnel/bal/main/slowdns/sld.sh -O sld.sh
    chmod +x sld.sh
    ./sld.sh
    clear
}

res10() {
    echo -e "${GREEN}    Memulai pengunduhan UDP CUSTOM...${NC}"
    mkdir -p /usr/local/kyt/
    wget -q -O /usr/local/kyt/udp-mini "${REPO}Fls/udp-mini"
     chmod +x /usr/local/kyt/udp-mini
    wget https://raw.githubusercontent.com/freetunnel/bal/main/system/udp-custom.sh -O udp-custom.sh
    chmod +x udp-custom.sh
    bash udp-custom.sh
    clear
}

res11() {
    echo -e "${GREEN}    Mengkonfigurasi Dropbear...${NC}"
    apt install dropbear -y
    sudo sed -i '/^DROPBEAR_PORT=/d' /etc/default/dropbear
    sudo sed -i '/^DROPBEAR_EXTRA_ARGS=/d' /etc/default/dropbear
    echo 'DROPBEAR_PORT=149' | sudo tee -a /etc/default/dropbear
    echo 'DROPBEAR_EXTRA_ARGS="-p 50000 -p 109 -p 110 -p 69 -b /etc/issue.net"' | sudo tee -a /etc/default/dropbear

    sudo mkdir -p /etc/dropbear/
    sudo dropbearkey -t dss -f /etc/dropbear/dropbear_dss_host_key
    sudo dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key
    sudo chmod 600 /etc/dropbear/dropbear_dss_host_key
    sudo chmod 600 /etc/dropbear/dropbear_rsa_host_key
    sudo chown root:root /etc/dropbear/dropbear_dss_host_key
    sudo chown root:root /etc/dropbear/dropbear_rsa_host_key
    sed -i 's/^NO_START=.*/NO_START=0/' /etc/default/dropbear
    sudo systemctl daemon-reload
    sudo systemctl restart dropbear
     sudo systemctl enable nginx
    clear
}
res12() {
    echo -e "${GREEN}   Mengatur jadwal reboot harian...${NC}"
    
    # Definisikan cron job yang ingin ditambahkan
    REBOOT_JOB="0 0 * * * /sbin/reboot"

    # Periksa apakah cron job tersebut sudah ada
    if ! sudo crontab -l | grep -Fxq "$REBOOT_JOB"; then
        # Jika TIDAK ADA, maka tambahkan
        (sudo crontab -l 2>/dev/null; echo "$REBOOT_JOB") | sudo crontab -
        echo -e "${GREEN}   -> Jadwal reboot otomatis setiap jam 12 malam telah berhasil ditambahkan.${NC}"
    else
        # Jika SUDAH ADA, beri pesan dan jangan lakukan apa-apa
        echo -e "${YELLOW}   -> Jadwal reboot otomatis sudah ada, tidak ada yang diubah.${NC}"
    fi
}
res13() {
    echo -e "${GREEN}    Mengatur jadwal update kuota otomatis...${NC}"
    
# Definisikan cron job yang ingin ditambahkan
USAGE_JOB="*/1 * * * * /usr/bin/update-usage.sh >/dev/null 2>&1"
USAGE_JOB2="*/2 * * * * /usr/bin/update-ssh-usage.sh >/dev/null 2>&1"

# Periksa dan tambahkan jadwal untuk kuota XRAY
    if ! sudo crontab -l | grep -Fxq "$USAGE_JOB"; then
        (sudo crontab -l 2>/dev/null; echo "$USAGE_JOB") | sudo crontab -
        echo -e "${GREEN}    -> Jadwal update kuota xray setiap 1 menit telah berhasil ditambahkan.${NC}"
    else
        echo -e "${YELLOW}    -> Jadwal update kuota xray sudah ada, tidak ada yang diubah.${NC}"
    fi

# Periksa dan tambahkan jadwal untuk kuota SSH
    if ! sudo crontab -l | grep -Fxq "$USAGE_JOB2"; then
    # PERBAIKAN 1: Gunakan variabel $USAGE_JOB2 di sini
        (sudo crontab -l 2>/dev/null; echo "$USAGE_JOB2") | sudo crontab -
    # PERBAIKAN 2: Sesuaikan pesan dengan jadwal (setiap 2 menit)
        echo -e "${GREEN}    -> Jadwal update kuota sshws setiap 2 menit telah berhasil ditambahkan.${NC}"
    else
        echo -e "${YELLOW}    -> Jadwal update kuota sshws sudah ada, tidak ada yang diubah.${NC}"
    fi
}


# --- Proses Instalasi
